from os import PathLike
from typing import Callable, Mapping, Union

__version__: str
HAS_DECIDER: bool

Result = Union[bool, str, float]

class DecisionSchema:
    @staticmethod
    def yes_no() -> DecisionSchema: ...
    @staticmethod
    def choice(options: list[str]) -> DecisionSchema: ...
    @staticmethod
    def score(min: float, max: float) -> DecisionSchema: ...
    @property
    def kind(self) -> str: ...
    @property
    def options(self) -> list[str] | None: ...
    @property
    def min(self) -> float | None: ...
    @property
    def max(self) -> float | None: ...

class DecisionRequest:
    @property
    def question(self) -> str: ...
    @property
    def context(self) -> str: ...
    @property
    def schema(self) -> DecisionSchema: ...

class DecisionResponse:
    def __init__(
        self, result: Result, confidence: float, model_id: str, latency_ms: int = 0
    ) -> None: ...
    @property
    def result(self) -> Result: ...
    @property
    def confidence(self) -> float: ...
    @property
    def model_id(self) -> str: ...
    @property
    def latency_ms(self) -> int: ...

class DecisionBackend: ...

class FixtureBackend(DecisionBackend):
    def __init__(self, response: DecisionResponse) -> None: ...
    @staticmethod
    def yes_no(result: bool, confidence: float) -> FixtureBackend: ...

class ErrorFixtureBackend(DecisionBackend):
    def __init__(self, message: str) -> None: ...

BackendCallable = Callable[[DecisionRequest], DecisionResponse]

class CallableBackend(DecisionBackend):
    def __init__(self, callable: BackendCallable) -> None: ...

class DeciderBackend(DecisionBackend):
    """Only present when built with the `decider` feature (see HAS_DECIDER)."""

    @staticmethod
    def connect(base_url: str, model_id: str) -> DeciderBackend: ...
    @staticmethod
    def spawn(
        serve_script: str | PathLike[str],
        model_id: str,
        port: int,
        env: Mapping[str, str] | None = None,
        health_timeout_secs: float = 60.0,
    ) -> DeciderBackend: ...

def ask(
    backend: DecisionBackend | BackendCallable,
    question: str,
    context: str,
    schema: DecisionSchema,
) -> DecisionResponse: ...

class DecisionError(Exception): ...
class UnsupportedSchemaError(DecisionError): ...
class SpawnFailedError(DecisionError): ...
class BackendUnavailableError(DecisionError): ...
class ServerExitedEarlyError(DecisionError): ...
class RequestFailedError(DecisionError): ...
class MalformedResponseError(DecisionError): ...
class BackendFailedError(DecisionError): ...
